---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';
const { social } = SITE_CONFIG;
---

<Layout title="关于我 - Senmoo">
  <div class="about-hero">
    <div class="about-avatar reveal">
      <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;border-radius:50%;">
        <defs>
          <linearGradient id="avatarBg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#C67C5B"/>
            <stop offset="50%" stop-color="#D4A574"/>
            <stop offset="100%" stop-color="#B89770"/>
          </linearGradient>
          <clipPath id="ac"><circle cx="200" cy="200" r="200"/></clipPath>
        </defs>
        <g clip-path="url(#ac)">
          <rect width="400" height="400" fill="url(#avatarBg)"/>
          <circle cx="100" cy="90" r="50" fill="rgba(255,255,255,0.06)"/>
          <circle cx="320" cy="310" r="70" fill="rgba(255,255,255,0.05)"/>
          <circle cx="310" cy="80" r="30" fill="rgba(255,255,255,0.04)"/>
          <text x="200" y="195" text-anchor="middle" dominant-baseline="central" font-family="Georgia,'Times New Roman',serif" font-size="160" font-weight="700" fill="rgba(255,255,255,0.95)" letter-spacing="-4">S</text>
          <text x="200" y="290" text-anchor="middle" font-family="-apple-system,'Helvetica Neue',sans-serif" font-size="36" font-weight="300" fill="rgba(255,255,255,0.85)" letter-spacing="8">Senmoo</text>
        </g>
      </svg>
    </div>
    <div class="about-text">
      <div class="section-label reveal">About Me</div>
      <h1 class="reveal">我是<span class="gradient-text">钟森木</span></h1>
      <p class="bio reveal">
        在互联网行业摸爬滚打多年，见过太多人被系统驯化、被节奏吞噬。
        当安稳变成一种慢性消耗，我选择亲手打破它——不是逃离，而是夺回人生的主动权。
      </p>
      <p class="bio reveal">
        AI 浪潮席卷而来，我看到的不是威胁，而是普通人百年难遇的破局利器。
        这一次，不再做旁观者。以身入局，顺势而起，在时代的裂缝中撕开属于自己的路。
      </p>
      <p class="bio reveal">
        这个网站就是我的数字实验室：记录思考、打磨产品、连接每一个不甘平庸的灵魂。
      </p>
    </div>
  </div>

</Layout>
