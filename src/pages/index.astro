---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config';
const config = SITE_CONFIG;
const { social } = config;
---

<Layout title="Senmoo - 个人AI创意实验室">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge">
        <span class="dot"></span>
        <span>Open to collaborate</span>
      </div>
      <h1 class="hero-title">
        个人AI<br><span class="gradient-text">创意实验室</span>
      </h1>
      <p class="hero-subtitle">
        专注打造属于普通人自己的AI产品，不仅限于编程/画图/视频，干中学，学以致用。
      </p>
      <div class="hero-actions">
        <a href="/tools" class="btn btn-primary">
          探索AI产品 <span>&rarr;</span>
        </a>
        <a href="/about" class="btn btn-ghost">
          了解更多
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Cards -->
  <section class="section">
    <div class="section-label reveal">What I Do</div>
    <h2 class="section-title reveal">我在做的事</h2>
    <p class="section-desc reveal">一个方向，持续打磨 —— 让复杂的事情变得简单而有趣。</p>
    <div class="featured-grid">
      {config.modules.decisionLens && (
        <a href="/tools" class="featured-card reveal">
          <div class="card-icon pink">&#9878;</div>
          <div class="card-title">AI产品</div>
          <div class="card-desc">把常见的决策困境变成可视化的互动工具。第一个作品：决策透镜，已上线。</div>
          <span class="card-tag">AI Products &rarr;</span>
        </a>
      )}

      {config.modules.about && (
        <a href="/about" class="featured-card reveal">
          <div class="card-icon orange">&#128640;</div>
          <div class="card-title">我的故事</div>
          <div class="card-desc">四十岁离开安稳，投身AI浪潮。在时代的洪流中寻找属于自己的那一小撮流沙。</div>
          <span class="card-tag">About &rarr;</span>
        </a>
      )}
    </div>
  </section>

  <!-- Latest Works Scroll -->
  <section class="section">
    <div class="section-label reveal">Latest</div>
    <h2 class="section-title reveal">最新动态</h2>
    <div class="works-scroll reveal">
      {config.modules.decisionLens && (
        <a href="/tools" class="work-item">
          <div class="work-thumb t2">&#9878;</div>
          <div class="work-info">
            <h4>决策透镜 v1.0 上线</h4>
            <p>AI产品 · 在线体验</p>
          </div>
        </a>
      )}
    </div>
  </section>
</Layout>
