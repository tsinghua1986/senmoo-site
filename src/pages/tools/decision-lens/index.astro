---
// Decision Lens - 内嵌子应用页面（独立全屏，不使用 Layout）
// 需要登录后才能使用
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/tools/decision-lens/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>决策透镜 | Decision Lens</title>
    <style is:global>
      body { margin: 0; font-family: -apple-system, sans-serif; background: #FAFAF7; }
      .dl-auth-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.4);
        display: flex; align-items: center; justify-content: center; z-index: 9999;
        animation: dlFadeIn 0.2s ease;
      }
      @keyframes dlFadeIn { from { opacity: 0; } to { opacity: 1; } }
      .dl-auth-card {
        background: #fff; border-radius: 16px; padding: 32px; width: 400px; max-width: 90vw;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15); position: relative;
        animation: dlSlideIn 0.25s ease;
      }
      @keyframes dlSlideIn {
        from { opacity: 0; transform: translateY(-20px) scale(0.97); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }
      .dl-auth-close {
        position: absolute; top: 16px; right: 16px;
        width: 28px; height: 28px; border: none; background: none;
        cursor: pointer; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.2s;
      }
      .dl-auth-close:hover { background: #f0f0f0; }
      .dl-auth-close::before, .dl-auth-close::after {
        content: ''; position: absolute;
        width: 16px; height: 2px; background: #999;
      }
      .dl-auth-close::before { transform: rotate(45deg); }
      .dl-auth-close::after { transform: rotate(-45deg); }
      .dl-auth-tabs {
        display: flex; border-bottom: 1px solid #eee; margin-bottom: 24px;
      }
      .dl-auth-tab {
        flex: 1; padding: 12px; border: none; background: none;
        font-size: 0.95rem; font-weight: 500; color: #999;
        cursor: pointer; position: relative; transition: color 0.2s;
      }
      .dl-auth-tab.active { color: #1a1a2e; }
      .dl-auth-tab.active::after {
        content: ''; position: absolute; bottom: -1px; left: 0; right: 0;
        height: 2px; background: #C67C5B; border-radius: 1px;
      }
      .dl-auth-tab:hover { color: #1a1a2e; }
      .dl-auth-form { display: flex; flex-direction: column; gap: 16px; }
      .dl-auth-field label {
        display: block; font-size: 0.82rem; color: #666;
        margin-bottom: 6px; font-weight: 500;
      }
      .dl-auth-field input {
        width: 100%; padding: 10px 14px; border: 1.5px solid #e0ddd8; border-radius: 10px;
        font-size: 0.92rem; outline: none; box-sizing: border-box; transition: border-color 0.2s;
        background: #FAFAF7;
      }
      .dl-auth-field input:focus { border-color: #C67C5B; }
      .dl-auth-btn {
        width: 100%; padding: 12px; border: none; border-radius: 999px;
        background: #C67C5B; color: #fff; font-size: 0.95rem; font-weight: 600;
        cursor: pointer; margin-top: 8px; transition: opacity 0.2s;
      }
      .dl-auth-btn:hover { opacity: 0.9; }
      .dl-auth-btn:disabled { opacity: 0.6; cursor: not-allowed; }
      .dl-auth-error {
        background: #fef0ed; color: #c0392b; padding: 10px 14px; border-radius: 10px;
        font-size: 0.83rem; margin-bottom: 16px;
      }
      .dl-auth-success {
        background: #edfaf0; color: #27ae60; padding: 10px 14px; border-radius: 10px;
        font-size: 0.83rem; margin-bottom: 16px;
      }
    </style>
  </head>
  <body>
    <div id="root"></div>
    <script is:inline type="module">
      const SUPABASE_URL = 'https://qwkqotkazgqpzqtjecvu.supabase.co';
      const SUPABASE_ANON_KEY = 'sb_publishable_yHdsg6K1ZON8QghpuhpElA_cptNP2MG';

      // 先加载决策透镜应用
      loadApp();

      // 然后检查登录状态
      (async () => {
        try {
          const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
          const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
          const { data } = await supabase.auth.getUser();
          if (!data?.user) {
            showAuthForm(supabase);
          }
        } catch (e) {
          console.error('Auth check failed:', e);
          // 即使认证检查失败，应用已经加载了
        }
      })();

      function getAuthHTML() {
        return `
        <div class="dl-auth-overlay" id="dl-auth-overlay">
          <div class="dl-auth-card">
            <button class="dl-auth-close" id="dl-auth-close-btn" aria-label="关闭"></button>
            <div class="dl-auth-tabs">
              <button class="dl-auth-tab active" id="dl-tab-login">登录</button>
              <button class="dl-auth-tab" id="dl-tab-register">注册</button>
            </div>
            <div class="dl-auth-error" id="dl-auth-error" style="display:none;"></div>
            <div class="dl-auth-success" id="dl-auth-success" style="display:none;"></div>
            <form class="dl-auth-form" id="dl-auth-form">
              <div class="dl-auth-field" id="dl-field-nickname" style="display:none">
                <label>昵称（选填）</label>
                <input type="text" id="dl-nickname" placeholder="你的昵称" />
              </div>
              <div class="dl-auth-field">
                <label>邮箱</label>
                <input type="email" id="dl-email" placeholder="your@email.com" required />
              </div>
              <div class="dl-auth-field">
                <label>密码</label>
                <input type="password" id="dl-password" placeholder="输入密码" required minlength="6" />
              </div>
              <div class="dl-auth-field" id="dl-field-confirm" style="display:none">
                <label>确认密码</label>
                <input type="password" id="dl-confirm" placeholder="再次输入密码" required minlength="6" />
              </div>
              <button type="submit" class="dl-auth-btn" id="dl-auth-submit">登  录</button>
            </form>
          </div>
        </div>`;
      }

      function showAuthForm(supabase) {
        const container = document.createElement('div');
        container.innerHTML = getAuthHTML();
        document.body.appendChild(container);
        bindAuthEvents(supabase, container);
      }

      function hideAuthForm(container) {
        container.remove();
      }

      function bindAuthEvents(supabase, container) {
        let isLogin = true;
        const form = container.querySelector('#dl-auth-form');
        const submitBtn = container.querySelector('#dl-auth-submit');
        const errorEl = container.querySelector('#dl-auth-error');
        const successEl = container.querySelector('#dl-auth-success');
        const tabLogin = container.querySelector('#dl-tab-login');
        const tabRegister = container.querySelector('#dl-tab-register');
        const closeBtn = container.querySelector('#dl-auth-close-btn');
        const overlay = container.querySelector('#dl-auth-overlay');
        const fieldNickname = container.querySelector('#dl-field-nickname');
        const fieldConfirm = container.querySelector('#dl-field-confirm');

        function switchMode(mode) {
          isLogin = mode === 'login';
          errorEl.style.display = 'none';
          successEl.style.display = 'none';
          if (isLogin) {
            tabLogin.classList.add('active');
            tabRegister.classList.remove('active');
            submitBtn.textContent = '登  录';
            fieldNickname.style.display = 'none';
            fieldConfirm.style.display = 'none';
          } else {
            tabRegister.classList.add('active');
            tabLogin.classList.remove('active');
            submitBtn.textContent = '注  册';
            fieldNickname.style.display = '';
            fieldConfirm.style.display = '';
          }
        }

        tabLogin.addEventListener('click', () => switchMode('login'));
        tabRegister.addEventListener('click', () => switchMode('register'));
        closeBtn.addEventListener('click', () => hideAuthForm(container));
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) hideAuthForm(container);
        });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorEl.style.display = 'none';
          successEl.style.display = 'none';
          submitBtn.disabled = true;

          const email = container.querySelector('#dl-email').value;
          const password = container.querySelector('#dl-password').value;

          if (isLogin) {
            const { error } = await supabase.auth.signInWithPassword({ email, password });
            if (error) {
              errorEl.textContent = error.message.includes('Invalid') ? '邮箱或密码错误' : error.message;
              errorEl.style.display = 'block';
              submitBtn.disabled = false;
            } else {
              successEl.textContent = '登录成功';
              successEl.style.display = 'block';
              setTimeout(() => hideAuthForm(container), 500);
            }
          } else {
            const confirm = container.querySelector('#dl-confirm').value;
            if (password !== confirm) {
              errorEl.textContent = '两次密码不一致';
              errorEl.style.display = 'block';
              submitBtn.disabled = false;
              return;
            }
            const nickname = container.querySelector('#dl-nickname').value;
            const { error } = await supabase.auth.signUp({
              email, password,
              options: { data: { nickname: nickname || '' } }
            });
            if (error) {
              errorEl.textContent = error.message.includes('already') ? '该邮箱已注册' : error.message;
              errorEl.style.display = 'block';
              submitBtn.disabled = false;
            } else {
              successEl.textContent = '注册成功';
              successEl.style.display = 'block';
              setTimeout(() => hideAuthForm(container), 500);
            }
          }
        });
      }

      function loadApp() {
        const script = document.createElement('script');
        script.type = 'module';
        script.src = '/tools/decision-lens/assets/index-DyHm7e-y.js';
        document.body.appendChild(script);
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/tools/decision-lens/assets/index-Q6YeN8NV.css';
        document.head.appendChild(link);
      }
    </script>
  </body>
</html>
